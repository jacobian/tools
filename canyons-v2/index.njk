---
layout: canyons.njk
title: JKM - Canyon Log
---

{# A cell that may be empty. Note the v1 idiom
   `{{ x if x else '<span>—</span>' | safe }}` does NOT work: the filter binds
   to the string literal rather than the conditional, so the markup renders
   escaped. #}
{% macro cell(value) %}
  {%- if value -%}{{ value }}{%- else -%}<span class="empty">—</span>{%- endif -%}
{% endmacro %}

{% macro canyon_name(canyon, route) %}
  {%- set label = canyon.name + " (" + route + ")" if route else canyon.name -%}
  {%- if canyon.url -%}<a href="{{ canyon.url }}">{{ label }}</a>{%- else -%}{{ label }}{%- endif -%}
{% endmacro %}

{% macro descent_cells(d) %}
  <td class="canyon-title">{{ canyon_name(d.canyon, d.route) }}</td>
  <td class="region">{{ cell(d.canyon.region) }}</td>
  <td class="rating">{{ cell(d.canyon.aca_rating or d.canyon.ffme_rating) }}</td>
  <td class="role">{{ d.role }}</td>
  <td class="flow">{{ cell(d.flow) }}</td>
  <td class="notes">
    {{- d.notes if d.notes -}}
    {%- if d.conditions %} <em>({{ d.conditions }})</em>{% endif -%}
  </td>
{% endmacro %}

<table class="canyons">
  <thead>
    <tr>
      <th>Date</th>
      <th>Canyon</th>
      <th>Region</th>
      <th>Rating</th>
      <th>Role</th>
      <th>Flow</th>
      <th>Notes</th>
    </tr>
  </thead>
  <tbody>
    {% for entry in canyonlog.log %}
      {# Stripe by outer entry so an event's rows read as one block. #}
      {% set stripe = "bg-stone-50" if loop.index % 2 == 0 else "bg-white" %}

      {% if entry.type == "descent" %}
        <tr class="{{ stripe }}">
          <td class="date">{{ entry.date.display }}</td>
          {{ descent_cells(entry) }}
        </tr>

      {% else %}
        {% for d in entry.descents %}
          <tr class="{{ stripe }}">
            {% if loop.first %}
              <td class="date" rowspan="{{ entry.descents | length }}">
                <h3>{{ entry.name }}</h3>
                <p>{{ entry.date.display }}</p>
              </td>
            {% endif %}
            {{ descent_cells(d) }}
          </tr>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </tbody>
</table>
